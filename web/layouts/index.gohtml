{{define "content"}}
{{/* The product itself, as structured data. The site, brand and operating
     company live in base.gohtml's graph and are referenced by @id from
     here rather than redeclared. Every claim below must stay true of
     docs/product.md — this is the machine-readable copy of the pitch. */}}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": "{{.Site.URL}}/#app",
  "name": "{{.Site.Name}}",
  "url": "{{.Site.URL}}",
  "applicationCategory": "SecurityApplication",
  "applicationSubCategory": "Password Manager",
  "operatingSystem": "Web",
  "browserRequirements": "Requires a modern browser with WebCrypto support",
  "description": "{{.Site.Description}}",
  "featureList": [
    "Zero-knowledge, end-to-end encrypted vault (logins, secure notes, payment cards, identities)",
    "Keys derived in the browser from a Master Password and a twelve-word Secret Phrase",
    "AES-256-GCM per-item encryption; item titles encrypted too",
    "Live cross-device sync",
    "Password and passphrase generator with an entropy meter",
    "One-time codes stored on a login and computed in the browser",
    "Multiple vaults, each with its own key",
    "Two-factor authentication and per-device session revocation",
    "Shared vaults and single-item share links",
    "Trash with 30-day retention and permanent delete",
    "No analytics, advertising or third-party trackers"
  ],
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "GBP" },
  "isPartOf": { "@id": "{{.Site.URL}}/#website" },
  "publisher": { "@id": "{{.Site.URL}}/#organization" }
}
</script>
<div class="min-h-screen flex flex-col text-foreground overflow-x-hidden">
    {{/* Fixed ambient layer: grid, grain and slow colour. Everything else
         sits on top of it, so no section needs its own backdrop. */}}
    <div class="site-canvas" aria-hidden="true">
        <div class="glow-orb glow-orb-a" style="--orb:var(--accent-glow);width:60vw;height:60vw;top:-24vw;right:-14vw"></div>
        <div class="glow-orb glow-orb-b" style="--orb:var(--accent-2-glow);width:46vw;height:46vw;bottom:-20vw;left:-12vw"></div>
    </div>

    {{template "publicHeader" .}}

    {{/* ───────── Hero ───────── */}}
    <section class="relative px-6 pt-12 pb-12 sm:pt-24 sm:pb-16">
        <div class="glow-orb" style="--orb:var(--accent-3-glow);width:420px;height:420px;top:-120px;left:38%;opacity:0.7"></div>

        <div class="relative max-w-5xl mx-auto grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
            <div>
                <div class="badge badge-rim mb-7 animate-fade">
                    <span class="w-1.5 h-1.5 rounded-full bg-accent animate-glow"></span>
                    Locked before it leaves your device
                </div>
                <h1 class="text-5xl font-extrabold tracking-tighter leading-tight mb-6">
                    Your secrets,<br />
                    <span class="text-gradient cipher-text" data-cipher-target>sealed.</span>
                </h1>
                <p class="text-lg text-muted-foreground leading-relaxed max-w-md mb-9">
                    Vault3 encrypts every password, note and card <em class="not-italic text-foreground">on your device</em>, before anything is sent. The server stores only the encrypted result. The key that opens it is built in your browser and stays there.
                </p>
                <div class="flex flex-wrap items-center gap-4">
                    <a href="/join" class="btn btn-primary btn-lg">Create your vault</a>
                    <a href="/security" class="btn btn-ghost btn-lg">How it works &rarr;</a>
                </div>
                <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-mono text-muted-foreground">
                    <span class="inline-flex items-center gap-1.5">
                        <svg class="h-3.5 w-3.5 text-accent-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                        free while in beta
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                        <svg class="h-3.5 w-3.5 text-accent-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                        no card required
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                        <svg class="h-3.5 w-3.5 text-accent-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                        no ads, no trackers
                    </span>
                </div>
            </div>

            {{/* Live sealing demo: landing.ts animates plaintext → ciphertext. */}}
            <div class="relative">
                <div class="glow-orb" style="--orb:var(--accent-glow);width:120%;height:110%;top:-5%;left:-10%;opacity:0.75"></div>
                <div class="relative panel p-6 shadow-accent animate-unseal" data-seal-demo>
                    <div class="flex items-center justify-between mb-5">
                        <div class="flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full" style="background:var(--danger)"></span>
                            <span class="w-2.5 h-2.5 rounded-full" style="background:var(--warning)"></span>
                            <span class="w-2.5 h-2.5 rounded-full" style="background:var(--success)"></span>
                        </div>
                        <span class="badge badge-accent font-mono text-[11px]" data-seal-state>sealing…</span>
                    </div>
                    <div class="space-y-4 font-mono text-sm">
                        <div>
                            <p class="text-xs text-muted-foreground mb-1">what you type, on your device</p>
                            <div class="rounded-lg border border-border bg-muted px-4 py-3 leading-relaxed">
                                <p><span class="text-muted-foreground">site&nbsp;&nbsp;&nbsp;&nbsp;</span><span data-seal-plain="site">acme-bank.com</span></p>
                                <p><span class="text-muted-foreground">user&nbsp;&nbsp;&nbsp;&nbsp;</span><span data-seal-plain="user">nora@fastmail.com</span></p>
                                <p><span class="text-muted-foreground">password&nbsp;</span><span data-seal-plain="pass">tr7#Vk-pearl-9Q</span></p>
                            </div>
                        </div>
                        <div class="flex items-center justify-center gap-3 text-muted-foreground">
                            <span class="h-px flex-1" style="background-image:linear-gradient(90deg,transparent,var(--accent-border))"></span>
                            <svg class="h-6 w-6 text-accent mark-pulse" viewBox="0 0 64 64" aria-hidden="true">
                                <rect width="64" height="64" rx="15" fill="currentColor" mask="url(#v3-cut)"/>
                            </svg>
                            <span class="h-px flex-1" style="background-image:linear-gradient(90deg,var(--accent-2-border),transparent)"></span>
                        </div>
                        <div>
                            <p class="text-xs text-muted-foreground mb-1">what the server receives and stores</p>
                            <div class="rounded-lg border border-accent-border bg-accent-subtle px-4 py-3 leading-relaxed break-all text-accent text-xs" data-seal-cipher>
                                gTf3JqXo9dLmWzPa41RkbNc8vHyEsQ2u…
                            </div>
                        </div>
                    </div>
                </div>
                <span class="absolute -bottom-3 -right-2 badge badge-accent-2 font-mono text-[11px] shadow-md" style="background:var(--card);border:1px solid var(--accent-2-border)">AES-256-GCM</span>
            </div>
        </div>
    </section>

    {{/* ───────── Ciphertext drift strip ─────────
         Two lanes running against each other: this is the view from the
         database side. */}}
    <section class="relative py-6 overflow-hidden" aria-hidden="true">
        <div class="rule-gradient absolute inset-x-0 top-0 opacity-70"></div>
        <div class="marquee-mask space-y-1.5">
            <div class="cipher-drift font-mono text-xs text-muted-foreground opacity-45" data-cipher-drift>
                &nbsp;A256GCM&nbsp;·&nbsp;pYx82hQm4LcTr9…&nbsp;·&nbsp;n:VfK73wZs…&nbsp;·&nbsp;c:M0dTye5RqJ1uHkAb…&nbsp;·&nbsp;A256GCM&nbsp;·&nbsp;kR4tW8zNvC2m…&nbsp;·&nbsp;n:Jd6Fq1Xp…&nbsp;·&nbsp;c:Bh9YsE3wLrG7iTnO…&nbsp;·&nbsp;
            </div>
            <div class="cipher-drift cipher-drift-reverse font-mono text-xs opacity-30" style="color:var(--accent-2)">
                &nbsp;c:Qw7RmZ2xTb…&nbsp;·&nbsp;HKDF-SHA256&nbsp;·&nbsp;n:Lp0Ge9Vd…&nbsp;·&nbsp;c:Xa5NuI8kYcF3jSpM…&nbsp;·&nbsp;PBKDF2&nbsp;·&nbsp;t:Rz1Cv6Bn…&nbsp;·&nbsp;c:Ok4WdA7hLmE2qYzX…&nbsp;·&nbsp;HKDF-SHA256&nbsp;·&nbsp;
            </div>
        </div>
        <div class="rule-gradient absolute inset-x-0 bottom-0 opacity-70"></div>
    </section>

    {{/* ───────── How it works ───────── */}}
    <section class="px-6 py-12 sm:py-16 scroll-reveal">
        <div class="max-w-5xl mx-auto">
            <p class="eyebrow mb-4">How it works</p>
            <h2 class="text-3xl font-bold tracking-tight mb-8 sm:mb-12 max-w-xl">Where your key comes from</h2>
            {{/* Each step says the thing in plain words and then shows the
                 machinery on one mono chip — the reader who wants the
                 parameters gets them without the sentence carrying them. */}}
            <div class="relative grid md:grid-cols-3 gap-5 sm:gap-6">
                {{/* Threads the three steps together; the panels paint over
                     it, so it only shows in the gutters. */}}
                <div class="step-rail hidden md:block" aria-hidden="true"></div>
                <div class="panel panel-interactive p-6 sm:p-7 scroll-reveal-child flex flex-col">
                    <span class="step-ghost" aria-hidden="true">01</span>
                    <div class="step-mark mb-4 sm:mb-5">01</div>
                    <h3 class="font-semibold text-lg mb-2">You hold both secrets</h3>
                    <p class="text-sm text-muted-foreground leading-relaxed">Your Master Password is the one you choose and keep in your head. Your Secret Phrase is twelve ordinary words your browser generates at sign-up and writes into your Emergency Kit. Both stay on your device.</p>
                    <div class="mt-auto pt-5"><span class="badge badge-accent font-mono text-[11px]">1 password · 12 words</span></div>
                </div>
                <div class="panel panel-interactive p-6 sm:p-7 scroll-reveal-child flex flex-col">
                    <span class="step-ghost" aria-hidden="true">02</span>
                    <div class="step-mark mb-4 sm:mb-5">02</div>
                    <h3 class="font-semibold text-lg mb-2">Your key is made in your browser</h3>
                    <p class="text-sm text-muted-foreground leading-relaxed">Unlocking combines your two secrets into a single key. The derivation is deliberately slow, which is what puts large-scale password guessing out of reach. The server receives a separate key that only proves your identity.</p>
                    <div class="mt-auto pt-5"><span class="badge badge-accent font-mono text-[11px]">PBKDF2-SHA512 &times; 1,000,000 &rarr; Argon2id · 64 MiB</span></div>
                </div>
                <div class="panel panel-interactive p-6 sm:p-7 scroll-reveal-child flex flex-col">
                    <span class="step-ghost" aria-hidden="true">03</span>
                    <div class="step-mark mb-4 sm:mb-5">03</div>
                    <h3 class="font-semibold text-lg mb-2">Only the encrypted copy is uploaded</h3>
                    <p class="text-sm text-muted-foreground leading-relaxed">Every item is encrypted under its own key before it leaves your device. A full copy of the database contains only the encrypted text shown above.</p>
                    <div class="mt-auto pt-5"><span class="badge badge-accent font-mono text-[11px]">AES-256-GCM · one key per item</span></div>
                </div>
            </div>
        </div>
    </section>

    {{/* ───────── Features ───────── */}}
    <section class="px-6 py-12 sm:py-16 scroll-reveal">
        <div class="max-w-5xl mx-auto">
            <p class="eyebrow mb-4">Features</p>
            {{/* The landing is the highlight reel: these six tiles are the
                 ones that sell the product, not the inventory. /features
                 carries the rest — vaults, sharing, the trash, the kit —
                 so this grid never has to grow to cover them. */}}
            <div class="mb-8 sm:mb-12 sm:flex sm:items-end sm:justify-between sm:gap-8">
                <h2 class="text-3xl font-bold tracking-tight max-w-xl">Everything a password manager does,<br/>with encryption that holds</h2>
                <a href="/features" class="inline-flex mt-4 sm:mt-0 text-sm text-muted-foreground hover:text-accent transition-colors whitespace-nowrap">See all features &rarr;</a>
            </div>
            {{/* A bento grid rather than six identical squares: each tile is
                 sized to the figure it carries, and each figure shows the
                 thing the tile claims. The figures are decorative — the
                 copy beside each one says it all on its own. */}}
            <div class="grid sm:grid-cols-2 lg:grid-cols-6 gap-5 sm:gap-6">
                {{/* Four items, four unreadable titles. */}}
                <div class="panel panel-interactive p-6 scroll-reveal-child lg:col-span-2 flex flex-col justify-center">
                    <div class="fig mb-5" aria-hidden="true">
                        <p class="fig-label mb-2.5">4 items · as the server stores them</p>
                        <div class="stack-row"><span class="stack-kind">login</span><span class="seal-bar" style="--w:74%"></span></div>
                        <div class="stack-row"><span class="stack-kind">note</span><span class="seal-bar" style="--w:52%;--delay:0.4s"></span></div>
                        <div class="stack-row"><span class="stack-kind">card</span><span class="seal-bar" style="--w:66%;--delay:0.8s"></span></div>
                        <div class="stack-row"><span class="stack-kind">identity</span><span class="seal-bar" style="--w:44%;--delay:1.2s"></span></div>
                    </div>
                    <h3 class="font-semibold mb-1.5">Item titles are encrypted too</h3>
                    <p class="text-sm text-muted-foreground leading-relaxed">Logins, notes, cards and identities. The server stores a count of your items and nothing about what they are — titles included.</p>
                </div>

                {{/* The twelve words, laid out the way the Emergency Kit prints them. */}}
                <div class="panel panel-interactive p-6 scroll-reveal-child lg:col-span-4 flex flex-col">
                    <h3 class="font-semibold mb-1.5">Twelve words, generated on your device</h3>
                    <p class="text-sm text-muted-foreground leading-relaxed max-w-md">Your second secret is twelve everyday words, picked at random by your browser. Easy to write down, possible to remember, and far too many combinations for anyone to search through — a quantum computer included.</p>
                    <div class="mt-auto pt-6" aria-hidden="true">
                        <div class="phrase-grid">
                            <span class="phrase-word"><i>1</i>harbor</span>
                            <span class="phrase-word"><i>2</i>velvet</span>
                            <span class="phrase-word"><i>3</i>anchor</span>
                            <span class="phrase-word"><i>4</i>meadow</span>
                            <span class="phrase-word"><i>5</i>copper</span>
                            <span class="phrase-word"><i>6</i>orbit</span>
                            <span class="phrase-word"><i>7</i>silent</span>
                            <span class="phrase-word"><i>8</i>marble</span>
                            <span class="phrase-word"><i>9</i>ridge</span>
                            <span class="phrase-word"><i>10</i>cobalt</span>
                            <span class="phrase-word"><i>11</i>thicket</span>
                            <span class="phrase-word"><i>12</i>lantern</span>
                        </div>
                        <p class="fig-label mt-3">12 words · 132 bits · made on your device</p>
                    </div>
                </div>

                {{/* A revision crossing the wire, laptop to desktop. */}}
                <div class="panel panel-interactive p-6 scroll-reveal-child lg:col-span-3 flex flex-col justify-center">
                    <h3 class="font-semibold mb-4">On all your devices, instantly</h3>
                    <div class="wire-row mb-4" aria-hidden="true">
                        <span class="wire-node">
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M2 20h20"/></svg>
                        </span>
                        <span class="wire"><i class="wire-dot"></i></span>
                        <span class="wire-node">
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>
                        </span>
                    </div>
                    <p class="text-sm text-muted-foreground leading-relaxed">Save a login on your laptop and it appears on your phone the same second, encrypted the whole way across. Changes are pushed as they happen rather than fetched on a schedule.</p>
                </div>

                {{/* A real password from the generator, tinted by character
                     class exactly as the app renders it. */}}
                <div class="panel panel-interactive p-6 scroll-reveal-child lg:col-span-3 flex flex-col justify-center">
                    <h3 class="font-semibold mb-1.5">Strong passwords, made for you</h3>
                    <p class="text-sm text-muted-foreground leading-relaxed mb-5">Random characters, or words that are easy to read aloud. The strength meter reports the actual work an attacker would need, and rates a weak password as weak.</p>
                    <div class="fig" aria-hidden="true">
                        <p class="text-sm mb-3" style="letter-spacing:0.04em">zP<span class="cc-digit">4</span><span class="cc-symbol">$</span>rune<span class="cc-symbol">-</span>Kx<span class="cc-digit">9</span><span class="cc-symbol">!</span>tvq</p>
                        <div class="meter mb-2"><i style="--fill:77%"></i></div>
                        <p class="fig-label">16 characters · 98 bits of randomness</p>
                    </div>
                </div>

                {{/* Six digits and the thirty seconds they last. */}}
                <div class="panel panel-interactive p-6 scroll-reveal-child lg:col-span-2 flex flex-col justify-center">
                    <h3 class="font-semibold mb-1.5">Two-factor authentication</h3>
                    <p class="text-sm text-muted-foreground leading-relaxed mb-5">Add a six-digit code from your authenticator app at sign-in. Every device you are signed in on is listed, and you can sign any of them out from any other.</p>
                    <div aria-hidden="true">
                        <div class="otp mb-2.5">
                            <span class="otp-digit">4</span>
                            <span class="otp-digit">8</span>
                            <span class="otp-digit">1</span>
                            <span class="otp-digit is-live">2</span>
                            <span class="otp-digit is-live">0</span>
                            <span class="otp-digit is-live">7</span>
                        </div>
                        <div class="otp-timer"><i></i></div>
                    </div>
                </div>

                {{/* The bell, mid-conversation. */}}
                <div class="panel panel-interactive p-6 scroll-reveal-child lg:col-span-4">
                    <div class="lg:flex lg:items-center lg:gap-8">
                        <div class="lg:w-2/5">
                            <h3 class="font-semibold mb-1.5">Security alerts</h3>
                            <p class="text-sm text-muted-foreground leading-relaxed">A new device signing in, a changed Master Password, two-factor switched off: each one reaches you as it happens, in the app and by email.</p>
                        </div>
                        <ul class="feed mt-5 lg:mt-0 lg:flex-1" aria-hidden="true">
                            <li class="is-new"><span class="feed-dot"></span>New device signed in<time>now</time></li>
                            <li><span class="feed-dot"></span>Master Password changed<time>3d</time></li>
                            <li><span class="feed-dot"></span>Two-factor enabled<time>2w</time></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {{/* ───────── Plain answers ─────────
         The questions a visitor who does not care about cryptography
         actually arrives with. Native <details>, so it opens with
         JavaScript off; the FAQPage graph below carries the same six
         answers for search and answer engines — change one, change both. */}}
    <section class="px-6 py-12 sm:py-16 scroll-reveal">
        <div class="max-w-3xl mx-auto">
            <p class="eyebrow mb-4">Plain answers</p>
            <h2 class="text-3xl font-bold tracking-tight mb-8 sm:mb-12 max-w-lg">What people ask before they sign up</h2>
            <div class="faq scroll-reveal-child">
                <details class="faq-item">
                    <summary>Do I need to understand any of this to use it?</summary>
                    <div class="faq-body">No. You choose a Master Password, save the Emergency Kit, and from then on it works like any other password manager: save things, find them, copy them where you need them. The encryption happens in your browser.</div>
                </details>
                <details class="faq-item">
                    <summary>What happens if I forget my Master Password?</summary>
                    <div class="faq-body">Your Emergency Kit is the way back in: it holds your email address and your twelve words. There is no reset email, because the server never sees your Master Password and cannot replace it. If both the password and the phrase are lost, the vault stays closed permanently, for us as well as for you.</div>
                </details>
                <details class="faq-item">
                    <summary>What would a hacker actually get?</summary>
                    <div class="faq-body">Encrypted text. Your items, their titles and your vault names are all encrypted before they reach the server, and the key that opens them is only ever in your browser.</div>
                </details>
                <details class="faq-item">
                    <summary>What can you see about me?</summary>
                    <div class="faq-body">Your email address, because that is how you sign in and how security alerts reach you. Beyond that: how many items you keep and when they last changed. The contents and the titles are encrypted.</div>
                </details>
                <details class="faq-item">
                    <summary>Is it really free?</summary>
                    <div class="faq-body">It is free while Vault3 is in beta, with no card required. There is no advertising and no analytics on the site, and nothing about you to sell.</div>
                </details>
                <details class="faq-item">
                    <summary>Does it work on my phone as well as my laptop?</summary>
                    <div class="faq-body">Yes, on any up-to-date browser. Sign in on each device and your vault stays in step across all of them, updating the second something changes.</div>
                </details>
            </div>
        </div>
    </section>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "@id": "{{.Site.URL}}/#faq",
      "isPartOf": { "@id": "{{.Site.URL}}/#website" },
      "about": { "@id": "{{.Site.URL}}/#app" },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Do I need to understand any of this to use it?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. You choose a Master Password, save the Emergency Kit, and from then on it works like any other password manager: save things, find them, copy them where you need them. The encryption happens in your browser." }
        },
        {
          "@type": "Question",
          "name": "What happens if I forget my Master Password?",
          "acceptedAnswer": { "@type": "Answer", "text": "Your Emergency Kit is the way back in: it holds your email address and your twelve-word Secret Phrase. There is no reset email, because Vault3 never sees your Master Password and cannot replace it. If both the password and the phrase are lost, the vault stays closed permanently, for Vault3 as well as for you." }
        },
        {
          "@type": "Question",
          "name": "What would a hacker actually get?",
          "acceptedAnswer": { "@type": "Answer", "text": "Encrypted text. Items, item titles and vault names are all encrypted on your device before they reach the server, and the key that opens them is only ever in your browser." }
        },
        {
          "@type": "Question",
          "name": "What can Vault3 see about me?",
          "acceptedAnswer": { "@type": "Answer", "text": "Your email address, because that is how you sign in and how security alerts reach you. Beyond that: how many items you keep and when they last changed. The contents and the titles are encrypted." }
        },
        {
          "@type": "Question",
          "name": "Is Vault3 really free?",
          "acceptedAnswer": { "@type": "Answer", "text": "Vault3 is free while it is in beta, with no card required. There is no advertising and no analytics on the site, and nothing about you to sell." }
        },
        {
          "@type": "Question",
          "name": "Does it work on a phone as well as a laptop?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes, on any up-to-date browser. Sign in on each device and your vault stays in step across all of them, updating the second something changes." }
        }
      ]
    }
    </script>

    {{template "siteFooter" .}}
</div>
{{end}}