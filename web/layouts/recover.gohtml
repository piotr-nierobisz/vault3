{{define "content"}}
{{/* Account recovery: the zero-knowledge reset. Rendered by recover.tsx into
     #recover-root. */}}
<div class="min-h-screen flex flex-col bg-background">
  <div class="px-6 pt-8 max-w-2xl mx-auto w-full">
    <a href="/" class="hover:opacity-80 transition-opacity">{{template "wordmark" .}}</a>
  </div>
  <div class="flex-1 flex items-start justify-center px-6 py-12">
    <div class="w-full max-w-2xl" id="recover-root"></div>
  </div>
</div>
{{end}}
